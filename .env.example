# Copy this file to .env.local (dev) or .env (production) and fill in real values.
# Never commit the real file.

# MongoDB connection string (self-hosted on the Oracle Linux server).
# If auth is enabled: mongodb://USER:PASSWORD@HOST:27017/shop_portal?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/shop_portal

# Secret used to sign NextAuth JWT sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app. Dev: http://localhost:3000
# Production: the https subdomain, e.g. https://shop.example.com
NEXTAUTH_URL=http://localhost:3000

# Folder where uploaded files are saved. Must be OUTSIDE /public.
# Dev: ./uploads   Production: use an absolute path, e.g. /var/www/shop-portal-uploads
UPLOAD_DIR=./uploads

# Cloudflare R2 (optional). When R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY and R2_BUCKET_NAME are all set,
# every uploaded photo is stored in this bucket (inside the folder R2_PREFIX) instead of UPLOAD_DIR, and is still shown only to
# signed-in users through /api/files/. Leave them empty to keep using UPLOAD_DIR. Never commit the real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public dev URL of the bucket (not used by the app: photos are served through the login-protected route).
R2_PUBLIC_URL=
# Folder inside the bucket for this app's photos (keeps them apart from anything else in the bucket).
R2_PREFIX=shop-portal/
